project_id          = "your-gcp-project-id"
region              = "us-central1"
gcs_bucket_name     = "your-project-rag-docs"
qdrant_collection   = "knowledge-base"
agent_default_model = "claude-sonnet"
image_tag           = "latest"

# ── IAP ───────────────────────────────────────────────────────────────────────
iap_support_email = "admin@your-domain.com"
portal_domain     = "portal.ai.your-domain.com"
ide_chat_domain   = "ide.ai.your-domain.com"

iap_allowed_users = [
  "user:alice@your-domain.com",
  "group:ai-platform-users@your-domain.com",
]
